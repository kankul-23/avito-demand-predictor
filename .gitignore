# Виртуальное окружение
.venv/

# Данные (тяжелые файлы не коммитим)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Тяжелые артефакты моделей (хранятся в MLflow/S3)
models/*.cbm
models/*.pkl
models/*.txt

# Логи, кэш и чекпоинты
catboost_info/
mlruns/
mlflow.db
.ipynb_checkpoints/
__pycache__/
*.pyc
.pytest_cache/

# Приватные файлы, доклады и заметки
*.docx
*.pptx

